// GLanglight resource file
#include <windows.h>
#include "resource_ids.h"

// Application icon (IDI_APPICON = 101, must match tray.h)
101 ICON "app.ico"

// ── Settings dialog ────────────────────────────────────────────────────
IDD_SETTINGS DIALOGEX 0, 0, 380, 226
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GLanglight - Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Keyboard languages and LED colours:", IDC_STATIC, 8, 6, 260, 10

    CONTROL         "", IDC_LANG_LIST,
                    "ListBox",
                    LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_BORDER | WS_TABSTOP | WS_VSCROLL,
                    8, 20, 364, 158

    PUSHBUTTON      "Change colour...", IDC_BTN_COLOR,  8,   188, 90, 14
    AUTOCHECKBOX    "Run at Windows startup", IDC_AUTOSTART, 8, 206, 150, 10
    DEFPUSHBUTTON   "OK",               IDOK,           280, 206, 42, 14
    PUSHBUTTON      "Cancel",           IDCANCEL,       328, 206, 42, 14
END
